# Supabase configuration (Publicly accessible but read-only by RLS)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Custom obscure admin slug route (e.g. manage-x7k9)
NEXT_PUBLIC_ADMIN_SLUG=manage-x7k9

# Contact Email configured for forwarding
NEXT_PUBLIC_CONTACT_EMAIL=elia@example.com

# Optional EmailJS configuration (if using client-side fallback)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
